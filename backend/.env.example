# Clé API YouTube Data v3 (https://console.cloud.google.com/apis/credentials)
# Active l'API "YouTube Data API v3" sur ton projet Google Cloud, puis crée une clé API.
YOUTUBE_API_KEY=

# Base de données (SQLite par défaut, aucune config nécessaire)
DATABASE_URL=sqlite:///./outliers.db

# Fréquence de rafraîchissement automatique (en heures)
REFRESH_INTERVAL_HOURS=2

# Une vidéo est un "outlier" si elle dépasse (médiane des vues du reste de la chaîne) x ce facteur
OUTLIER_MULTIPLIER=3.0

# Vues minimum absolues pour être considéré comme outlier (évite le bruit sur les micro-chaînes)
MIN_VIEWS_FLOOR=3000

# Nombre minimum de vidéos dans l'historique d'une chaîne pour calculer une baseline fiable
MIN_HISTORY_VIDEOS=5

# Nombre de vidéos récentes analysées par chaîne à chaque rafraîchissement
MAX_VIDEOS_PER_CHANNEL=30

# Origines autorisées en CORS (séparées par des virgules). "*" = tout autoriser (pratique en local)
CORS_ORIGINS=*
